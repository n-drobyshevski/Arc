{
  "name": "arc-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:views": "vite build && vite build --config vite.guide.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:views && npm run build:server && npm run typecheck",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "mcp-handler": "^2.3.0",
    "preact": "^11.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
